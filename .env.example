# Frontend API base URL. The bundled FastAPI demo runs on this address.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public CARTO basemap key. The app accepts both VITE_ and NEXT_PUBLIC_ names.
# Request a key at https://carto.com/basemaps/apikey/
VITE_CARTO_BASEMAP_KEY=cb1_2xz3_1_1cfe3f0669dc3e5589400282

# Public MapLibre style URL (optional). Leave blank to use CARTO Voyager vector tiles.
VITE_MAP_STYLE_URL=

# Keep true to allow clearly labeled local demo data when the backend is offline.
VITE_DEMO_MODE=true

# API paths can be changed without editing source code.
VITE_API_ROUTES_PATH=/api/routes/calculate
VITE_API_RECALCULATE_PATH=/api/routes/recalculate
VITE_API_SCAN_START_PATH=/api/hazards/scanning/start
VITE_API_SCAN_STOP_PATH=/api/hazards/scanning/stop
VITE_API_SCAN_FRAME_PATH=/api/hazards/scan-frame
VITE_API_HAZARD_CONFIRM_PATH=/api/hazards/confirm
VITE_API_HEALTH_PATH=/api/health
VITE_API_GEOCODE_PATH=/api/geocode/search
