# Keep Live route calculation enabled. Demo mode is selected in the frontend.
ANIROUTE_LIVE_ROUTING_ENABLED=true

# Any OSRM-compatible route service can be used here.
ANIROUTE_ROUTING_URL=https://router.project-osrm.org
ANIROUTE_ROUTING_PROFILE=driving
ANIROUTE_PROVIDER_TIMEOUT_SECONDS=18

# Nominatim requires an identifiable User-Agent.
ANIROUTE_GEOCODER_USER_AGENT=AniRoute/1.0 (local development)

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Computer vision -------------------------------------------------------
# Model A: our fine-tuned road-surface model. Model B: COCO-pretrained obstruction model.
ANIROUTE_MODEL_PATH=backend/models/aniroute-hazards-v1.pt
ANIROUTE_OBSTRUCTION_MODEL_PATH=backend/models/yolo11n.pt
# auto = fastest compatible export (ONNX on Apple Silicon; OpenVINO, ONNX, then PyTorch elsewhere)
ANIROUTE_MODEL_FORMAT=auto
# Supplemental OpenCV check for reflective, water-filled potholes.
ANIROUTE_ENABLE_WATER_POTHOLE_DETECTOR=true
# High-confidence profile: 78.3% precision and 13.6% recall on the held-out test split.
ANIROUTE_CONF_THRESHOLD=0.40
ANIROUTE_OBSTRUCTION_CONF_THRESHOLD=0.45
ANIROUTE_IMGSZ=640
# Driving corridor for Model B (fractions of the frame)
ANIROUTE_ROI_TOP=0.40
ANIROUTE_ROI_TOP_HALF_WIDTH=0.10
ANIROUTE_ROI_BOTTOM_HALF_WIDTH=0.25
ANIROUTE_ROI_MIN_HEIGHT=0.12
# Alert only when a hazard appears in MIN_HITS of the last WINDOW frames
ANIROUTE_SMOOTHING_WINDOW=3
ANIROUTE_SMOOTHING_MIN_HITS=2
ANIROUTE_HAZARD_COOLDOWN_S=20
ANIROUTE_HAZARD_DEDUPE_M=50
